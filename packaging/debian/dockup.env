# Dockup hub configuration. Restart after editing:  systemctl restart dockup
# Format: KEY=value  (no quotes, no "export")

# Listen address. Put a TLS reverse proxy (nginx, Caddy, Traefik) in front for HTTPS.
DOCKUP_ADDR=:8080

# Public URL of this hub. Required for OAuth callbacks and used in notification links.
#DOCKUP_URL=https://deploy.example.com

# Set to 1 when behind a reverse proxy that sets X-Forwarded-For / -Proto / -Host.
#DOCKUP_TRUST_PROXY=1

# Optional: create the first admin from config instead of the web setup screen.
#DOCKUP_ADMIN_USER=admin
#DOCKUP_ADMIN_PASSWORD=change-me-please
# Or invite an admin who signs in with SSO (binds to this verified email):
#DOCKUP_ADMIN_EMAIL=you@example.com
# Otherwise the first admin is created in the browser with the one-time setup
# code from `journalctl -u dockup` (also in /var/lib/dockup/setup-code).

# Optional: derive the secret-encryption key from this value instead of a generated key file.
#DOCKUP_SECRET_KEY=

# OAuth / SSO (enable any). Callback URL = <DOCKUP_URL>/auth/<github|google|oidc>/callback
#DOCKUP_GITHUB_CLIENT_ID=
#DOCKUP_GITHUB_CLIENT_SECRET=
#DOCKUP_GOOGLE_CLIENT_ID=
#DOCKUP_GOOGLE_CLIENT_SECRET=
#DOCKUP_OIDC_ISSUER=https://sso.example.com/realms/main
#DOCKUP_OIDC_CLIENT_ID=
#DOCKUP_OIDC_CLIENT_SECRET=
#DOCKUP_OIDC_NAME=Company SSO
